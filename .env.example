# Copy this file to .env and fill in the key(s) for whichever provider(s) you use.
# .env is gitignored - never commit your actual keys. Only set the ONE provider you
# intend to use; the others can stay blank or be left out entirely.

# --- gemini (default provider) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- anthropic ---
# ANTHROPIC_API_KEY=

# --- openai ---
# OPENAI_API_KEY=

# --- bedrock --- (uses the standard AWS credential chain instead; usually `aws configure`,
#                  not these variables - only set them if you don't already have a profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# --- optional: force a provider/model without passing --provider/--model every time ---
# TASKCLI_PROVIDER=gemini
# TASKCLI_MODEL=gemini-3.1-flash-lite
